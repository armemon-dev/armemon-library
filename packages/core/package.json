{
  "name": "@armemon-library/core",
  "version": "0.1.0",
  "description": "Runtime for armemon-scaffolded apps — task-orchestration init engine and plugin provider chain.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts,.tsx",
    "test": "vitest run --config ../../vitest.config.ts packages/core/test"
  },
  "dependencies": {
    "@armemon-library/config-types": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "react-native": "^0.76.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "eslint": "^9.39.1",
    "vitest": "^2.1.0"
  },
  "author": {
    "name": "Ahmed Raza Memon",
    "url": "https://github.com/armemon-dev"
  },
  "homepage": "https://github.com/armemon-dev/armemon-library#readme",
  "bugs": {
    "url": "https://github.com/armemon-dev/armemon-library/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armemon-dev/armemon-library.git",
    "directory": "packages/core"
  },
  "keywords": [
    "react-native",
    "provider",
    "init",
    "task-orchestration",
    "armemon"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
