{
  "name": "@armemon-library/cli",
  "version": "0.1.0",
  "description": "Interactive scaffolding CLI for React Native apps — plugins, splash screen, and advanced init in one wizard.",
  "license": "MIT",
  "bin": {
    "armemon": "./dist/bin/armemon.js",
    "memon": "./dist/bin/armemon.js"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src bin test --ext .ts,.tsx",
    "test": "vitest run --config ../../vitest.config.ts packages/cli-armemon/test"
  },
  "dependencies": {
    "@armemon-library/advanced-init": "^0.1.0",
    "@armemon-library/splash": "^0.1.0",
    "@armemon-library/cli-kit": "^0.1.0",
    "@armemon-library/core": "^0.1.0",
    "@armemon-library/config-types": "^0.1.0",
    "@armemon-library/essentials": "^0.1.0",
    "@armemon-library/navigation": "^0.1.0",
    "@armemon-library/redux": "^0.1.0",
    "@armemon-library/ui": "^0.1.0",
    "@clack/prompts": "^0.8.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "execa": "^9.0.0",
    "semver": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/semver": "^7.5.8",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "eslint": "^9.39.1",
    "vitest": "^2.1.0"
  },
  "author": {
    "name": "Ahmed Raza Memon",
    "url": "https://github.com/armemon-dev"
  },
  "homepage": "https://github.com/armemon-dev/armemon-library#readme",
  "bugs": {
    "url": "https://github.com/armemon-dev/armemon-library/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armemon-dev/armemon-library.git",
    "directory": "packages/cli-armemon"
  },
  "keywords": [
    "react-native",
    "cli",
    "scaffolding",
    "generator",
    "boilerplate",
    "plugins"
  ],
  "publishConfig": {
    "access": "public"
  }
}
