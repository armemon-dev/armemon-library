{
  "name": "@armemon-library/essentials",
  "version": "0.1.0",
  "description": "Notifications, network monitoring, and loading/error overlays for armemon-scaffolded apps.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/runtime/index.js",
  "types": "./dist/runtime/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/runtime/index.d.mts",
        "default": "./dist/runtime/index.mjs"
      },
      "require": {
        "types": "./dist/runtime/index.d.ts",
        "default": "./dist/runtime/index.js"
      }
    },
    "./wizard": {
      "types": "./dist/wizard/index.d.mts",
      "import": "./dist/wizard/index.mjs"
    },
    "./package.json": "./package.json",
    "./netinfo": {
      "import": {
        "types": "./dist/runtime/network/netInfoAdapter.d.mts",
        "default": "./dist/runtime/network/netInfoAdapter.mjs"
      },
      "require": {
        "types": "./dist/runtime/network/netInfoAdapter.d.ts",
        "default": "./dist/runtime/network/netInfoAdapter.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "netinfo"
  ],
  "armemon": {
    "manifestVersion": 1,
    "pluginId": "essentials",
    "displayName": "Essentials",
    "description": "Toast notifications, network monitoring, and loading/error overlays.",
    "category": "utility",
    "required": false,
    "runtimeExportName": "EssentialsPlugin",
    "configExportName": "configureEssentialsPlugin",
    "peerPackages": [
      "@react-native-community/netinfo"
    ],
    "settings": {
      "file": "essentials/essentials.config.ts",
      "exportName": "essentialsConfig"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup --config tsup.runtime.config.ts && tsup --config tsup.wizard.config.ts",
    "dev": "tsup --config tsup.runtime.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts,.tsx",
    "test": "vitest run --config ../../vitest.config.ts packages/plugin-essentials/test"
  },
  "dependencies": {
    "@armemon-library/config-types": "^0.1.0"
  },
  "peerDependencies": {
    "@react-native-community/netinfo": ">=11.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.71.0",
    "@armemon-library/cli-kit": ">=0.1.0 <1.0.0"
  },
  "devDependencies": {
    "@armemon-library/cli-kit": "^0.1.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "eslint": "^9.39.1",
    "react": "^18.3.0",
    "react-native": "^0.76.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependenciesMeta": {
    "@react-native-community/netinfo": {
      "optional": true
    },
    "@armemon-library/cli-kit": {
      "optional": true
    }
  },
  "sideEffects": false,
  "author": {
    "name": "Ahmed Raza Memon",
    "url": "https://github.com/armemon-dev"
  },
  "homepage": "https://github.com/armemon-dev/armemon-library#readme",
  "bugs": {
    "url": "https://github.com/armemon-dev/armemon-library/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armemon-dev/armemon-library.git",
    "directory": "packages/plugin-essentials"
  },
  "keywords": [
    "react-native",
    "toast",
    "netinfo",
    "armemon-plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
