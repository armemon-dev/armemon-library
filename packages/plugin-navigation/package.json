{
  "name": "@armemon-library/navigation",
  "version": "0.1.0",
  "description": "React Navigation plugin for armemon — stack/tabs/drawer setup with placeholder screens.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/runtime/index.js",
  "types": "./dist/runtime/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/runtime/index.d.mts",
        "default": "./dist/runtime/index.mjs"
      },
      "require": {
        "types": "./dist/runtime/index.d.ts",
        "default": "./dist/runtime/index.js"
      }
    },
    "./wizard": {
      "types": "./dist/wizard/index.d.mts",
      "import": "./dist/wizard/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "armemon": {
    "manifestVersion": 1,
    "pluginId": "navigation",
    "displayName": "React Navigation",
    "description": "Stack, bottom tabs, or drawer navigation with placeholder screens and optional deep linking.",
    "category": "navigation",
    "required": false,
    "runtimeExportName": "NavigationPlugin",
    "configExportName": "configureNavigationPlugin",
    "peerPackages": [
      "@react-navigation/native",
      "react-native-screens",
      "react-native-safe-area-context"
    ],
    "dependsOn": [
      "redux"
    ]
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup --config tsup.runtime.config.ts && tsup --config tsup.wizard.config.ts",
    "dev": "tsup --config tsup.runtime.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts,.tsx",
    "test": "vitest run --config ../../vitest.config.ts packages/plugin-navigation/test"
  },
  "dependencies": {
    "@armemon-library/config-types": "^0.1.0"
  },
  "peerDependencies": {
    "@react-navigation/native": ">=7.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.70.0",
    "@armemon-library/cli-kit": ">=0.1.0 <1.0.0"
  },
  "devDependencies": {
    "@armemon-library/cli-kit": "^0.1.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "eslint": "^9.39.1",
    "react": "^18.3.0",
    "react-native": "^0.76.0",
    "react-native-safe-area-context": "5.1.0",
    "react-native-screens": "4.5.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "sideEffects": false,
  "author": {
    "name": "Ahmed Raza Memon",
    "url": "https://github.com/armemon-dev"
  },
  "homepage": "https://github.com/armemon-dev/armemon-library#readme",
  "bugs": {
    "url": "https://github.com/armemon-dev/armemon-library/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armemon-dev/armemon-library.git",
    "directory": "packages/plugin-navigation"
  },
  "keywords": [
    "react-native",
    "react-navigation",
    "armemon-plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependenciesMeta": {
    "@armemon-library/cli-kit": {
      "optional": true
    }
  }
}
